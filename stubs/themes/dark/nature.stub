--background: oklch(12.9% 0.042 264.695);
--foreground: oklch(86.9% 0.022 252.894);
--title-foreground: hsl(0 0% 100%);
--card: oklch(12.9% 0.042 264.695);
--card-foreground: hsl(0 0% 100%);
--popover: oklch(12.9% 0.042 264.695);
--popover-foreground: oklch(86.9% 0.022 252.894);
--primary: oklch(62.7% 0.194 149.214);
--primary-foreground: hsl(0 0% 100%);
--secondary: oklch(64.8% 0.2 131.684);
--secondary-foreground: hsl(0 0% 100%);
--accent: oklch(60% 0.118 184.704);
--accent-foreground: hsl(0 0% 100%);
--muted: oklch(20.8% 0.042 265.755);
--muted-foreground: oklch(70.4% 0.04 256.788);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: oklch(20.8% 0.042 265.755);
--input: oklch(27.9% 0.041 260.031);
--ring: var(--primary);
--surface-background: color-mix(in oklab, var(--muted) 70%, transparent);
--border-strong: oklch(37.2% 0.044 257.287);
--border-card: oklch(27.9% 0.041 260.031);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: var(--secondary);
--chart-3: var(--accent);
--chart-4: color-mix(in oklab, var(--primary) 70%, white);
--chart-5: color-mix(in oklab, var(--secondary) 70%, white);
