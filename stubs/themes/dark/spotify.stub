--background: hsl(0 0% 7%);
--foreground: hsl(0 0% 87%);
--title-foreground: hsl(0 0% 100%);
--card: hsl(0 0% 11%);
--card-foreground: hsl(0 0% 100%);
--popover: hsl(0 0% 11%);
--popover-foreground: hsl(0 0% 87%);
--primary: hsl(141 73% 42%);
--primary-foreground: hsl(0 0% 0%);
--secondary: hsl(0 0% 18%);
--secondary-foreground: hsl(0 0% 100%);
--accent: hsl(141 63% 48%);
--accent-foreground: hsl(0 0% 0%);
--muted: hsl(0 0% 15%);
--muted-foreground: hsl(0 0% 65%);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: hsl(141 73% 42%);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: hsl(0 0% 18%);
--input: hsl(0 0% 22%);
--ring: var(--primary);
--surface-background: hsl(0 0% 9%);
--border-strong: hsl(0 0% 30%);
--border-card: hsl(0 0% 18%);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: hsl(141 50% 55%);
--chart-3: hsl(141 40% 65%);
--chart-4: hsl(0 0% 45%);
--chart-5: hsl(0 0% 55%);
