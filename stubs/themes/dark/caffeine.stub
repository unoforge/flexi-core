--background: hsl(20 15% 8%);
--foreground: hsl(30 12% 82%);
--title-foreground: hsl(30 15% 93%);
--card: hsl(20 15% 11%);
--card-foreground: hsl(30 15% 93%);
--popover: hsl(20 15% 11%);
--popover-foreground: hsl(30 12% 82%);
--primary: hsl(25 55% 40%);
--primary-foreground: hsl(0 0% 100%);
--secondary: hsl(35 45% 35%);
--secondary-foreground: hsl(0 0% 100%);
--accent: hsl(30 65% 45%);
--accent-foreground: hsl(0 0% 100%);
--muted: hsl(20 12% 16%);
--muted-foreground: hsl(25 10% 58%);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: hsl(20 12% 18%);
--input: hsl(20 10% 22%);
--ring: var(--primary);
--surface-background: hsl(20 12% 6%);
--border-strong: hsl(20 10% 30%);
--border-card: hsl(20 10% 20%);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: var(--secondary);
--chart-3: var(--accent);
--chart-4: hsl(30 40% 50%);
--chart-5: hsl(35 30% 55%);
