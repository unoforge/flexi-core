--background: hsl(30 5% 12%);
--foreground: hsl(35 10% 85%);
--title-foreground: hsl(35 15% 95%);
--card: hsl(30 5% 14%);
--card-foreground: hsl(35 15% 95%);
--popover: hsl(30 5% 14%);
--popover-foreground: hsl(35 10% 85%);
--primary: hsl(20 70% 55%);
--primary-foreground: hsl(0 0% 100%);
--secondary: hsl(30 30% 25%);
--secondary-foreground: hsl(35 15% 90%);
--accent: hsl(15 60% 50%);
--accent-foreground: hsl(0 0% 100%);
--muted: hsl(30 5% 18%);
--muted-foreground: hsl(30 8% 60%);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: hsl(30 5% 20%);
--input: hsl(30 5% 24%);
--ring: var(--primary);
--surface-background: hsl(30 5% 10%);
--border-strong: hsl(30 5% 32%);
--border-card: hsl(30 5% 22%);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: hsl(15 55% 60%);
--chart-3: hsl(30 40% 50%);
--chart-4: hsl(35 25% 40%);
--chart-5: hsl(20 50% 65%);
