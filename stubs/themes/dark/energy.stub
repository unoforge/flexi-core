--background: oklch(14.7% 0.004 49.25);
--foreground: oklch(86.9% 0.005 56.366);
--title-foreground: hsl(0 0% 100%);
--card: oklch(14.7% 0.004 49.25);
--card-foreground: hsl(0 0% 100%);
--popover: oklch(14.7% 0.004 49.25);
--popover-foreground: oklch(86.9% 0.005 56.366);
--primary: oklch(66.6% 0.179 58.318);
--primary-foreground: hsl(0 0% 100%);
--secondary: oklch(68.1% 0.162 75.834);
--secondary-foreground: hsl(0 0% 100%);
--accent: oklch(64.8% 0.2 131.684);
--accent-foreground: hsl(0 0% 100%);
--muted: oklch(21.6% 0.006 56.043);
--muted-foreground: oklch(70.9% 0.01 56.259);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: oklch(21.6% 0.006 56.043);
--input: oklch(26.8% 0.007 34.298);
--ring: var(--primary);
--surface-background: color-mix(in oklab, var(--muted) 70%, transparent);
--border-strong: oklch(37.4% 0.01 67.558);
--border-card: oklch(26.8% 0.007 34.298);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: var(--secondary);
--chart-3: var(--accent);
--chart-4: color-mix(in oklab, var(--primary) 70%, white);
--chart-5: color-mix(in oklab, var(--secondary) 70%, white);
