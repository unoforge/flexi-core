--background: hsl(0 0% 100%);
--foreground: oklch(37.4% 0.01 67.558);
--title-foreground: oklch(21.6% 0.006 56.043);
--card: hsl(0 0% 100%);
--card-foreground: oklch(21.6% 0.006 56.043);
--popover: hsl(0 0% 100%);
--popover-foreground: oklch(37.4% 0.01 67.558);
--primary: hsl(2, 85%, 47%);
--primary-foreground: hsl(0 0% 100%);
--secondary: hsl(15, 100%, 48%);
--secondary-foreground: hsl(0 0% 100%);
--accent: hsl(209, 92%, 36%);
--accent-foreground: hsl(0 0% 100%);
--muted: oklch(97% 0.001 106.424);
--muted-foreground: oklch(44.4% 0.011 73.639);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: oklch(92.3% 0.003 48.717);
--input: oklch(92.3% 0.003 48.717);
--ring: var(--primary);
--surface-background: oklch(98.5% 0.001 106.423);
--border-strong: oklch(86.9% 0.005 56.366);
--border-card: var(--border);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: var(--secondary);
--chart-3: var(--accent);
--chart-4: color-mix(in oklab, var(--primary) 70%, white);
--chart-5: color-mix(in oklab, var(--secondary) 70%, white);
