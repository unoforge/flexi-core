--background: hsl(40 20% 98%);
--foreground: hsl(30 10% 25%);
--title-foreground: hsl(30 10% 15%);
--card: hsl(0 0% 100%);
--card-foreground: hsl(30 10% 15%);
--popover: hsl(0 0% 100%);
--popover-foreground: hsl(30 10% 25%);
--primary: hsl(20 70% 50%);
--primary-foreground: hsl(0 0% 100%);
--secondary: hsl(35 25% 92%);
--secondary-foreground: hsl(30 10% 25%);
--accent: hsl(15 60% 45%);
--accent-foreground: hsl(0 0% 100%);
--muted: hsl(35 15% 95%);
--muted-foreground: hsl(30 8% 45%);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: hsl(35 15% 89%);
--input: hsl(35 15% 89%);
--ring: var(--primary);
--surface-background: hsl(40 15% 96%);
--border-strong: hsl(35 10% 80%);
--border-card: var(--border);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: hsl(15 55% 55%);
--chart-3: hsl(30 40% 45%);
--chart-4: hsl(35 25% 35%);
--chart-5: hsl(20 50% 60%);
