--background: hsl(0 0% 100%);
--foreground: hsl(0 0% 15%);
--title-foreground: hsl(0 0% 7%);
--card: hsl(0 0% 100%);
--card-foreground: hsl(0 0% 7%);
--popover: hsl(0 0% 100%);
--popover-foreground: hsl(0 0% 15%);
--primary: hsl(141 73% 37%);
--primary-foreground: hsl(0 0% 100%);
--secondary: hsl(0 0% 95%);
--secondary-foreground: hsl(0 0% 15%);
--accent: hsl(141 63% 43%);
--accent-foreground: hsl(0 0% 100%);
--muted: hsl(0 0% 96%);
--muted-foreground: hsl(0 0% 40%);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: hsl(141 73% 37%);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: hsl(0 0% 90%);
--input: hsl(0 0% 90%);
--ring: var(--primary);
--surface-background: hsl(0 0% 98%);
--border-strong: hsl(0 0% 82%);
--border-card: var(--border);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: hsl(141 50% 50%);
--chart-3: hsl(141 40% 60%);
--chart-4: hsl(0 0% 60%);
--chart-5: hsl(0 0% 75%);
