--background: hsl(35 20% 97%);
--foreground: hsl(20 15% 22%);
--title-foreground: hsl(20 18% 12%);
--card: hsl(0 0% 100%);
--card-foreground: hsl(20 18% 12%);
--popover: hsl(0 0% 100%);
--popover-foreground: hsl(20 15% 22%);
--primary: hsl(25 55% 35%);
--primary-foreground: hsl(0 0% 100%);
--secondary: hsl(35 35% 88%);
--secondary-foreground: hsl(20 15% 22%);
--accent: hsl(30 60% 40%);
--accent-foreground: hsl(0 0% 100%);
--muted: hsl(30 15% 94%);
--muted-foreground: hsl(20 10% 42%);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: hsl(30 15% 88%);
--input: hsl(30 15% 88%);
--ring: var(--primary);
--surface-background: hsl(35 15% 95%);
--border-strong: hsl(30 10% 78%);
--border-card: var(--border);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: var(--secondary);
--chart-3: var(--accent);
--chart-4: hsl(30 40% 45%);
--chart-5: hsl(35 30% 50%);
