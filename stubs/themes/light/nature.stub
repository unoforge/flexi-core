--background: hsl(0 0% 100%);
--foreground: oklch(37.2% 0.044 257.287);
--title-foreground: oklch(20.8% 0.042 265.755);
--card: hsl(0 0% 100%);
--card-foreground: oklch(20.8% 0.042 265.755);
--popover: hsl(0 0% 100%);
--popover-foreground: oklch(37.2% 0.044 257.287);
--primary: oklch(62.7% 0.194 149.214);
--primary-foreground: hsl(0 0% 100%);
--secondary: oklch(64.8% 0.2 131.684);
--secondary-foreground: hsl(0 0% 100%);
--accent: oklch(60% 0.118 184.704);
--accent-foreground: hsl(0 0% 100%);
--muted: oklch(96.8% 0.007 247.896);
--muted-foreground: oklch(44.6% 0.043 257.281);
--destructive: oklch(57.7% 0.245 27.325);
--destructive-foreground: hsl(0 0% 100%);
--success: oklch(59.6% 0.145 163.225);
--warning: oklch(64.6% 0.222 41.116);
--info: oklch(58.8% 0.158 241.966);
--border: oklch(92.9% 0.013 255.508);
--input: oklch(92.9% 0.013 255.508);
--ring: var(--primary);
--surface-background: oklch(98.4% 0.003 247.858);
--border-strong: oklch(86.9% 0.022 252.894);
--border-card: var(--border);
--border-input: var(--input);
--chart-1: var(--primary);
--chart-2: var(--secondary);
--chart-3: var(--accent);
--chart-4: color-mix(in oklab, var(--primary) 70%, white);
--chart-5: color-mix(in oklab, var(--secondary) 70%, white);
